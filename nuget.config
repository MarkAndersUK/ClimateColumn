<?xml version="1.0" encoding="utf-8"?>
<!--
  All package sources are cleared, so restore resolves purely from the local NuGet cache
  (~/.nuget/packages) and never reaches the network.

  ClimateColumn.Core and ClimateColumn.Cli have no package dependencies whatsoever and
  build under this configuration from a cold cache. ClimateColumn.Tests uses MSTest, so it
  needs its packages present in the cache first. Populate them once with:

      pwsh scripts/populate-package-cache.ps1

  after which build, test and restore all work offline. See scripts/README.md.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
